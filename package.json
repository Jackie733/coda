{
  "name": "minimal-agent-hono",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A minimal tool-calling agent API built with TypeScript and Hono.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "inspect": "tsx src/cli.ts",
    "patch": "tsx src/patch.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "dotenv": "^16.6.1",
    "hono": "^4.10.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
